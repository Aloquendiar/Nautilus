<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nautilus</RootNamespace>
    <AssemblyName>Nautilus</AssemblyName>
    <ApplicationIcon>submarine.ico</ApplicationIcon>
    <StartupObject>Nautilus.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Assembly info (replaces Properties/AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>5.6.4.0</Version>
    <AssemblyVersion>5.6.4.0</AssemblyVersion>
    <FileVersion>5.6.4.0</FileVersion>
    <Product>Nautilus</Product>
    <Description>Tool suite to create, edit and work with Rock Band files</Description>
    <Copyright>Copyright © TrojanNemo, 2013-2026</Copyright>

    <!-- Suppress .NET Framework compatibility warnings for legacy DLLs -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- Resolve .NET 8 MethodInvoker ambiguity (System.Windows.Forms vs System.Reflection) -->
  <ItemGroup>
    <Using Include="System.Windows.Forms.MethodInvoker" Alias="MethodInvoker" />
  </ItemGroup>

  <!-- Exclude files that were not compiled in the original project or are duplicates -->
  <ItemGroup>
    <Compile Remove="Mogg - Copy.cs" />
    <Compile Remove="OpenFileOrFolderDialog.cs" />
  </ItemGroup>

  <!-- NuGet PackageReferences (migrated from packages.config) -->
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.2" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Windows.Forms.DataVisualization" Version="1.0.0-prerelease.20110.1" />
  </ItemGroup>

  <!-- Direct DLL references (legacy .NET Framework DLLs in compatibility mode) -->
  <ItemGroup>
    <Reference Include="Bass.Net">
      <HintPath>lib\Bass.Net.dll</HintPath>
    </Reference>
    <Reference Include="DevComponents.DotNetBar2">
      <HintPath>lib\DevComponents.DotNetBar2.dll</HintPath>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>lib\DocumentFormat.OpenXml.dll</HintPath>
    </Reference>
    <Reference Include="IPAddressControlLib">
      <HintPath>lib\IPAddressControlLib.dll</HintPath>
    </Reference>
    <Reference Include="MidiCS">
      <HintPath>lib\MidiCS.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Midi">
      <HintPath>lib\NAudio.Midi.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Core">
      <HintPath>lib\NAudio.Core.dll</HintPath>
    </Reference>
    <Reference Include="NautilusFREE">
      <HintPath>lib\NautilusFREE.dll</HintPath>
    </Reference>
    <Reference Include="PdfFileWriter">
      <HintPath>lib\PdfFileWriter.dll</HintPath>
    </Reference>
    <Reference Include="PsarcLib">
      <HintPath>lib\PsarcLib.dll</HintPath>
    </Reference>
    <Reference Include="SharpMp4Parser">
      <HintPath>lib\SharpMp4Parser.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.FtpClient">
      <HintPath>lib\System.Net.FtpClient.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Embedded resources and content -->
  <ItemGroup>
    <Content Include="submarine.ico" />
  </ItemGroup>

</Project>